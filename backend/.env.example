PORT=4000
NODE_ENV=development
# Local development only: skip two-step at sign-in, enable the no-email password reset.
# Has no effect unless NODE_ENV=development. Never set on a server.
DEV_AUTH_SHORTCUTS=true
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tula_carbon_db?schema=public"
# cPanel showcase only (no PostgreSQL there). Then run: npm run mysql:setup
# DATABASE_URL="mysql://CPANELUSER_dbuser:PASSWORD@localhost:3306/CPANELUSER_tulacarbon"
PYTHON_SERVICE_URL=http://localhost:8000
STORAGE_DIR=storage

# AI document reading (server only; never expose to the browser)
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-nano
OPENAI_API_KEY=your_api_key_here
# Or: AI_PROVIDER=gemini, AI_MODEL=gemini-2.5-flash-lite, GEMINI_API_KEY=...
# USD per million tokens, from the provider's current price list. Leave empty to skip cost estimates.
AI_INPUT_COST_PER_MILLION=
AI_OUTPUT_COST_PER_MILLION=
